<?xml version="1.0" encoding="UTF-8"?>
<!-- Settings for the "Publish SNAPSHOT" step in ci.yml. Maven 3.10 sends a server's credentials only to the hosts it
     knows for that id, and the id "central" is bound to Maven Central (repo.maven.apache.org), so the Central Portal
     snapshot repository is declared as an origin of the token. The token comes from the environment. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.3.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.3.0 https://maven.apache.org/xsd/settings-1.3.0.xsd">
    <servers>
        <server>
            <id>central</id>
            <username>${env.CENTRAL_TOKEN_USER}</username>
            <password>${env.CENTRAL_TOKEN_PASSWORD}</password>
            <repositoryOrigins>
                <repositoryOrigin>https://central.sonatype.com</repositoryOrigin>
            </repositoryOrigins>
        </server>
    </servers>
</settings>
